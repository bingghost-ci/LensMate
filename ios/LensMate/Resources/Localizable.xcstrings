    "When on, voice input uses the glasses' Bluetooth microphone for true hands-free use, and falls back to the phone mic automatically when the glasses aren't the audio device. Uses more battery. Turn off to always use the phone mic.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, voice input uses the glasses' Bluetooth microphone for true hands-free use, and falls back to the phone mic automatically when the glasses aren't the audio device. Uses more battery. Turn off to always use the phone mic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，语音输入使用眼镜的蓝牙麦克风；眼镜未作为音频设备时自动切换到手机麦克风。此功能会增加耗电。关闭后始终使用手机麦克风。"
          }
        }
      }
    },
    "You": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你"
          }
        }
      }
    },
    "You can re-download it anytime.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can re-download it anytime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以随时重新下载。"
          }
        }
      }
    },
    "You sign in on your Hermes login page with its username and password; LensMate only keeps the tokens Hermes issues, in the Keychain. Approvals Hermes asks for are read out, and you answer yes or no. Requests for passwords or secrets are always declined.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sign in on your Hermes login page with its username and password; LensMate only keeps the tokens Hermes issues, in the Keychain. Approvals Hermes asks for are read out, and you answer yes or no. Requests for passwords or secrets are always declined."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将在 Hermes 登录页输入用户名和密码；LensMate 仅在钥匙串中保存 Hermes 签发的令牌。Hermes 请求确认时会语音播报，你可回答是或否。索取密码或秘密信息的请求始终会被拒绝。"
          }
        }
      }
    },
    "You speak through your glasses. Your partner speaks only when you open the phone microphone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You speak through your glasses. Your partner speaks only when you open the phone microphone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你用眼镜麦克风说话；只有你按下按钮后，手机才会录制对方说话。"
          }
        }
      }
    },
    "You're All Set!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
