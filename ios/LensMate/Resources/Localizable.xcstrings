    "Your glasses turn is submitted after this pause. Default: 5 seconds. Your partner's phone recording always ends with the Stop button. Changes are saved automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your glasses turn is submitted after this pause. Default: 5 seconds. Your partner's phone recording always ends with the Stop button. Changes are saved automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你说话停顿达到此时长后自动提交，默认 5 秒。对方的手机录音仍由停止按钮结束。修改后自动保存。"
          }
        }
      }
    },
