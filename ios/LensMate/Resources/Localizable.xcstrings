    },
    "Kokoro-82M is a natural on-device neural voice running via Apple MLX — private and offline once downloaded (~600 MB). Best paired with the Apple Intelligence backend, or when the local Gemma model isn't loaded, to leave memory headroom.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokoro-82M is a natural on-device neural voice running via Apple MLX — private and offline once downloaded (~600 MB). Best paired with the Apple Intelligence backend, or when the local Gemma model isn't loaded, to leave memory headroom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokoro-82M 通过 Apple MLX 在设备上生成自然语音。下载约 600 MB 的模型后即可离线使用。建议搭配 Apple Intelligence，或在未加载本地 Gemma 模型时使用，以留出足够内存。"
          }
        }
      }
    },
