    "Kokoro is a natural, on-device neural voice — private and offline. Download its model (~600 MB) under Kokoro Model, then it runs entirely on-device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokoro is a natural, on-device neural voice — private and offline. Download its model (~600 MB) under Kokoro Model, then it runs entirely on-device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokoro 可在设备上生成自然语音，支持离线使用。在“Kokoro 模型”中下载约 600 MB 的模型后，即可完全在设备上运行。"
          }
        }
      }
    },
    "Kokoro model isn't downloaded yet.": {
      "extractionState": "manual",
