    "iOS exposes no temperature sensor or per-core clocks — thermal is a four-level state, and CPU is this app's threads summed across cores (>100% is normal).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS exposes no temperature sensor or per-core clocks — thermal is a four-level state, and CPU is this app's threads summed across cores (>100% is normal)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不提供温度传感器读数或各核心频率。温度以四级状态表示；CPU 为应用线程在所有核心上的占用总和，超过 100% 属正常情况。"
          }
        }
      }
    },
