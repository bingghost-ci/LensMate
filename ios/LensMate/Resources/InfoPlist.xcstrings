{
  "sourceLanguage": "en",
  "strings": {
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate connects to your Meta Ray-Ban glasses via Bluetooth to access the camera and microphone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate 通过蓝牙连接 Meta Ray-Ban 眼镜，以访问相机和麦克风。"
          }
        }
      }
    },
    "NSBluetoothPeripheralUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate connects to your Meta Ray-Ban glasses via Bluetooth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate 通过蓝牙连接 Meta Ray-Ban 眼镜。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate reads and adds calendar events when you ask by voice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate 根据你的语音请求读取和添加日历事件。"
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate reads and adds calendar events when you ask by voice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate 根据你的语音请求读取和添加日历事件。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate uses the camera to capture photos that the AI can analyze and describe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate 使用相机拍摄照片，供 AI 分析和描述。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate can use your location to provide location-aware responses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate 可使用你的位置提供与所在地相关的回复。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate uses the microphone for voice commands and conversation translation. Translation recordings are sent to your configured Aliyun service after each turn ends."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate 使用麦克风接收语音指令并进行对话翻译。翻译录音会在每句结束后发送至你配置的阿里云服务。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate can save captured photos to your photo library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate 可将拍摄的照片保存到你的照片图库。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate can access your photo library to share images with the AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate 可访问照片图库，以便与 AI 分享图片。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate creates reminders when you ask by voice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate 根据你的语音请求创建提醒事项。"
          }
        }
      }
    },
    "NSRemindersUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate creates reminders when you ask by voice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate 根据你的语音请求创建提醒事项。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate uses speech recognition to detect your wake word (\"Ok LensMate\") and transcribe your voice commands."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LensMate 使用语音识别检测唤醒词“Ok LensMate”，并将语音指令转写为文字。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
